generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  user
  assistant
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  doctors   Doctor[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}

model Doctor {
  id         String    @id @default(cuid())
  name       String
  specialty  String
  city       String
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([city, specialty])
  @@index([hospitalId])
}

model Conversation {
  id        String    @id @default(cuid())
  ownerId   String
  locale    String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId, updatedAt])
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  providerResults  Json?
  toolCalls        Json?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}